{
  "name": "rationale-ext",
  "displayName": "Rationale",
  "description": "Generate rationale for a GitHub commit.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished", "onCommand:rationale.explainCommit"],
  "contributes": {
    "commands": [
      {
        "command": "rationale.explainCommit",
        "title": "Rationale: Search via Commit..."
      }
    ],
    "configuration": {
      "title": "Rationale",
      "properties": {
        "rationale.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable used to create the private backend environment."
        },
        "rationale.model": {
          "type": "string",
          "default": "o4-mini",
          "description": "OpenAI model used for rationale analysis."
        },
        "rationale.runs": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Identification runs used for majority voting."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
